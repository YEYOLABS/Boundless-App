{
  "expo": {
    "name": "Boundless Driver",
    "slug": "Boundlessdriver",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/boundless.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/boundless.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.Natively",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "This app needs access to your camera to take photos of receipts for expense tracking.",
        "NSPhotoLibraryUsageDescription": "This app needs access to your photo library to select receipt images for expense tracking."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/boundless.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.anonymous.Natively",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/images/boundless.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      "expo-router",
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "This app needs access to your photo library to select receipt images for expense tracking.",
          "cameraPermission": "This app needs access to your camera to take photos of receipts for expense tracking."
        }
      ]
    ],
    "scheme": "natively",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "45442f0f-74d0-444f-994a-fbfbb7f92c61"
      }
    },
    "owner": "iflixin"
  }
}
